    <include file="assets/assets_single.xml"/>
    <include file="assets/gripper_assets_single.xml"/>
    <compiler meshdir=""/>
    <include file="../furniture_sim/simpleTable/simpleTable_asset.xml"/>

    <asset>
        <texture name="floor_grid_tex"
                 type="2d"
                 builtin="checker"
                 width="1024" height="1024"
                 rgb1="0.48 0.48 0.48"
                 rgb2="0.48 0.48 0.48"
                 mark="none"/>

        <material name="floor_grid_mat"
                  texture="floor_grid_tex"
                  texrepeat="6 6"
                  texuniform="true"
                  reflectance="0.0"/>

        <texture name="white_sky"
                 type="skybox"
                 builtin="gradient"
                 rgb1="0.72 0.72 0.72"
                 rgb2="0.72 0.72 0.72"
                 width="256"
                 height="1536"/>
    </asset>

    <visual>
        <headlight ambient="0.65 0.65 0.65"
                   diffuse="0.45 0.45 0.45"
                   specular="0.05 0.05 0.05"/>
        <rgba haze="0.72 0.72 0.72 1"/>
    </visual>

    <worldbody>
        <light name="main_light"
               pos="0 0 5"
               dir="0 0 -1"
               diffuse="0.85 0.85 0.85"
               specular="0.05 0.05 0.05"
               directional="true"/>

        <geom name="floor"
              type="plane"
              size="0 0 0.05"
              material="floor_grid_mat"
              contype="1"
              conaffinity="1"
              friction="1 0.005 0.0001"/>

        <body name="shelf" pos="0.6 0 0.9" quat="0.70710678 0 0 0.70710678">
            
            <!-- 왼쪽 벽 -->
            <geom name="left_wall"  pos="-0.5 0 0" size="0.02 0.2 0.90" type="box" rgba="0.6 0.4 0.2 1"/>
            <!-- 오른쪽 벽 -->
            <geom name="right_wall" pos="0.5 0 0"  size="0.02 0.2 0.90" type="box" rgba="0.6 0.4 0.2 1"/>
            <!-- 뒷면 -->
            <geom name="back_wall"  pos="0 -0.2 0" size="0.5 0.02 0.90" type="box" rgba="0.5 0.3 0.1 1"/>
            
            <!-- 1층 -->
            <geom name="shelf_1" pos="0 0 -0.80" size="0.5 0.2 0.02" type="box" rgba="0.8 0.6 0.4 1"/>
            <!-- 2층 -->
            <geom name="shelf_2" pos="0 0 -0.40" size="0.5 0.2 0.02" type="box" rgba="0.8 0.6 0.4 1"/>
            <!-- 3층 -->
            <geom name="shelf_3" pos="0 0 0.00" size="0.5 0.2 0.02" type="box" rgba="0.8 0.6 0.4 1"/>
            <!-- 4층 -->
            <geom name="shelf_4" pos="0 0 0.40"  size="0.5 0.2 0.02" type="box" rgba="0.8 0.6 0.4 1"/>
            <!-- 5층 -->
            <geom name="shelf_5" pos="0 0 0.80"  size="0.5 0.2 0.02" type="box" rgba="0.8 0.6 0.4 1"/>

        </body>

        <body name="object" pos="0.43 0.0 1.1">
            <freejoint/>
            <inertial pos="0 0 0" mass="0.001" diaginertia="0.002 0.002 0.002"/>

            <geom name="pot_wall_back" type="box"
                    size="0.02 0.025 0.1"
                    density="1500"
                    />

        </body>

        <body name="object_2" pos="-0.05 -0.3 0.5">
            <freejoint/>
            <inertial pos="0 0 0.0" mass="0.1" diaginertia="0.002 0.002 0.002"/>

            <geom name="box"
                  type="box"
                  friction="2.0 0.02 0.001"
                  size="0.3 0.1 0.5"
                  pos="0 0 0"
                  rgba="1 0 0 0.35"
                  mass="0"/>
        </body>

        <body name="object_3" pos="0.1 0.3 0.25">
            <freejoint/>
            <inertial pos="0 0 0.0" mass="0.1" diaginertia="0.002 0.002 0.002"/>

            <geom name="box_2"
                  type="box"
                  friction="2.0 0.02 0.001"
                  size="0.1 0.1 0.25"
                  pos="0 0 0"
                  rgba="1 0 0 0.35"
                  mass="0"/>
        </body>

        <body name="base_link">
            <body name="panda0_base_link" pos="0.0 0.0 0.0">
                <include file="assets/chain0_single.xml"/>
            </body>
        </body>
        
    </worldbody>

    <include file="assets/actuator0.xml"/>
    <include file="assets/gripper_actuator0.xml"/>

</mujoco>
